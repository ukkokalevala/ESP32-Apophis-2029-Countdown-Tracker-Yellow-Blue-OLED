#include <WiFi.h>
#include <Wire.h>
#include <U8g2lib.h>
#include <time.h>

// ================= CONFIG =================
const char* ssid     = "YOUR_SSID";
const char* password = "YOUR_PASSWORD";

// >>> Yellow/blue OLED: try SH1106 first (most common for this panel) <<<
U8G2_SH1106_128X64_NONAME_F_HW_I2C u8g2(U8G2_R0, U8X8_PIN_NONE);
// If text still overlaps, comment the line above and uncomment this:
//U8G2_SSD1306_128X64_NONAME_F_HW_I2C u8g2(U8G2_R0, U8X8_PIN_NONE);

const char* ntpServer      = "pool.ntp.org";
const long  gmtOffset_sec  = 0;
const int   daylightOffset = 0;

// Apophis closest approach: 2029-04-13 21:46 UTC
const int TARGET_YEAR   = 2029;
const int TARGET_MONTH  = 4;
const int TARGET_DAY    = 13;
const int TARGET_HOUR   = 21;
const int TARGET_MINUTE = 46;
// ==========================================

void showMsg(const char* l1, const char* l2 = nullptr) {
  u8g2.clearBuffer();
  u8g2.setFont(u8g2_font_6x10_tf);
  u8g2.drawStr(0, 12, l1);
  if (l2) u8g2.drawStr(0, 26, l2);
  u8g2.sendBuffer();
}

void setup() {
  Serial.begin(115200);

  Wire.begin(7, 6);
  Wire.setClock(100000);

  u8g2.begin();

  showMsg("Connecting WiFi...");
  WiFi.mode(WIFI_STA);
  WiFi.begin(ssid, password);

  unsigned long start = millis();
  while (WiFi.status() != WL_CONNECTED && millis() - start < 20000) {
    delay(500);
    Serial.print(".");
  }

  if (WiFi.status() != WL_CONNECTED) {
    showMsg("WiFi failed", "Check credentials");
  } else {
    showMsg("WiFi OK", "Syncing time...");
    configTime(gmtOffset_sec, daylightOffset, ntpServer);
  }
}

void loop() {
  struct tm timeinfo;
  bool ok = getLocalTime(&timeinfo, 1000);

  if (!ok || timeinfo.tm_year < 120) {
    showMsg("Waiting for NTP...",
            WiFi.status() == WL_CONNECTED ? "" : "No WiFi");
    delay(1000);
    return;
  }

  struct tm targetTime = {0};
  targetTime.tm_year  = TARGET_YEAR - 1900;
  targetTime.tm_mon   = TARGET_MONTH - 1;
  targetTime.tm_mday  = TARGET_DAY;
  targetTime.tm_hour  = TARGET_HOUR;
  targetTime.tm_min   = TARGET_MINUTE;
  targetTime.tm_sec   = 0;
  targetTime.tm_isdst = 0;

  time_t now    = mktime(&timeinfo);
  time_t target = mktime(&targetTime);
  if (now == (time_t)-1 || target == (time_t)-1) {
    showMsg("Time calc error");
    delay(1000);
    return;
  }

  long diff = (long)difftime(target, now);

  u8g2.clearBuffer();

  // ---- Yellow zone (top ~16 rows) ----
  u8g2.setFont(u8g2_font_6x10_tf);
  u8g2.drawStr(0, 10, "APOPHIS 2029 FLYBY");
  u8g2.drawLine(0, 12, 127, 12);

  // ---- Blue zone (y = 16..63) ----
  if (diff > 0) {
    long days    = diff / 86400L;
    int  hours   = (int)((diff % 86400L) / 3600L);
    int  minutes = (int)((diff % 3600L) / 60L);
    int  seconds = (int)(diff % 60L);

    char buf[24];
    snprintf(buf, sizeof(buf), "%ldd %02d:%02d:%02d",
             days, hours, minutes, seconds);

    u8g2.drawStr(0, 26, "T-MINUS:");
    u8g2.drawStr(0, 38, buf);
  } else {
    u8g2.setFont(u8g2_font_10x20_tf);
    u8g2.drawStr(0, 34, "FLYBY!");
  }

  u8g2.setFont(u8g2_font_6x10_tf);
  u8g2.drawStr(0, 52, "Dist: 38,012 km");
  u8g2.drawStr(0, 63, "Vel:  ~7.4 km/s");

  u8g2.sendBuffer();
  delay(1000);
}
